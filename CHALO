<!DOCTYPE html><html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CHALO - Your Ride, Our Responsibility</title><style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #101010;
    color: white;
    padding: 22px;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 35px;
}

.logo {
    font-size: 32px;
    font-weight: 900;
    color: #ffd600;
    letter-spacing: 2px;
}

.profile {
    background: #252525;
    padding: 12px;
    border-radius: 50%;
}

h1 {
    font-size: 27px;
    margin-bottom: 10px;
}

.subtitle {
    color: #aaa;
    margin-bottom: 28px;
}

.location {
    background: #222;
    padding: 18px;
    border-radius: 14px;
    margin-bottom: 14px;
}

.location label {
    color: #ffd600;
    font-size: 12px;
    display: block;
    margin-bottom: 8px;
}

.location input {
    background: transparent;
    border: none;
    outline: none;
    color: white;
    font-size: 16px;
    width: 100%;
}

h2 {
    margin: 30px 0 18px;
    font-size: 20px;
}

.rides {
    display: flex;
    gap: 12px;
}

.ride {
    flex: 1;
    background: #222;
    border: 1px solid #444;
    border-radius: 15px;
    padding: 20px 8px;
    text-align: center;
    cursor: pointer;
}

.ride.active {
    border: 2px solid #ffd600;
    background: #302b13;
}

.icon {
    font-size: 35px;
    margin-bottom: 10px;
}

.ride p {
    font-weight: bold;
}

.ride small {
    color: #aaa;
    display: block;
    margin-top: 7px;
}

button {
    width: 100%;
    margin-top: 30px;
    padding: 18px;
    border: none;
    border-radius: 12px;
    background: #ffd600;
    color: #111;
    font-size: 17px;
    font-weight: bold;
}

footer {
    text-align: center;
    color: #888;
    margin-top: 30px;
    font-size: 12px;
}
</style></head><body><header>
    <div class="logo">CHALO.</div>
    <div class="profile">👤</div>
</header><h1>Where are you going?</h1>
<p class="subtitle">Your journey starts with CHALO.</p><div class="location">
    <label>PICKUP LOCATION</label>
    <input type="text" placeholder="Enter pickup location">
</div><div class="location">
    <label>DROP LOCATION</label>
    <input type="text" placeholder="Where to?">
</div><h2>Choose your ride</h2><div class="rides"><div class="ride active" onclick="selectRide(this)">
    <div class="icon">🏍️</div>
    <p>Bike</p>
    <small>Quick ride</small>
</div>

<div class="ride" onclick="selectRide(this)">
    <div class="icon">🛺</div>
    <p>Auto</p>
    <small>Comfort ride</small>
</div>

<div class="ride" onclick="selectRide(this)">
    <div class="icon">🚗</div>
    <p>Car</p>
    <small>Premium ride</small>
</div>

</div><button onclick="bookRide()">BOOK YOUR RIDE</button>

<footer>
    CHALO © 2026<br>
    Your Ride, Our Responsibility.
</footer><script>
let selectedRide = "Bike";

function selectRide(element) {
    document.querySelectorAll(".ride").forEach(ride => {
        ride.classList.remove("active");
    });

    element.classList.add("active");
    selectedRide = element.querySelector("p").innerText;
}

function bookRide() {
    alert("CHALO " + selectedRide +
    " selected! This is a demo. Live booking is not available yet.");
}
</script></body>
</html>